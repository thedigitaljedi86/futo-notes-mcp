{
  "name": "futo-notes-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server for a self-hosted FUTO Notes sync server (end-to-end encrypted note read/write).",
  "author": "Nikolaj Hansen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedigitaljedi86/futo-notes-mcp.git"
  },
  "homepage": "https://github.com/thedigitaljedi86/futo-notes-mcp#readme",
  "bugs": {
    "url": "https://github.com/thedigitaljedi86/futo-notes-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "futo-notes-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "start": "node dist/index.js"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
